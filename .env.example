# Copy to .env and fill in real values. Never commit .env — it is gitignored.

# --- Flask core ---
# Required. The app refuses to start without it unless FLASK_DEBUG is on.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to "true" only for local development. Leave unset/false in production.
FLASK_DEBUG=false

# --- Email (Flask-Mail) ---
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# --- AI providers ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Test login panel (development only) ---
# When "true", the login page DISPLAYS these credentials and autofills them.
# Never enable in production. Requires both passwords below to be set.
ENABLE_TEST_LOGIN=false
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_USER_USERNAME=user
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
